{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PawTrack private exercise session record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "ownerId",
    "petId",
    "templateId",
    "profileId",
    "profileVersion",
    "dataVersion",
    "timeZone",
    "localDate",
    "startedAt",
    "endedAt",
    "answers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "ownerId": {
      "type": "string",
      "minLength": 1
    },
    "petId": {
      "type": "string",
      "minLength": 1
    },
    "templateId": {
      "type": "string",
      "minLength": 1
    },
    "profileId": {
      "enum": [
        "attempt_based",
        "duration_based",
        "milestone_based",
        "observation_based"
      ]
    },
    "profileVersion": {
      "const": 1
    },
    "dataVersion": {
      "type": "integer",
      "minimum": 1
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "description": "IANA zone; application must validate against its timezone database."
    },
    "localDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "answers": {
      "type": "object",
      "description": "Validate using the pinned profile, conditional fields and supported field types before saving."
    },
    "derivedSummary": {
      "type": [
        "object",
        "null"
      ],
      "description": "Recomputed by application; never accept client score or XP as authoritative."
    },
    "practicedLessonIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Optional context only: IDs of practiced lessons belonging to templateId. Never creates separate forms, sessions or rewards."
    }
  }
}
