  "rankProgression": {
    "schemaVersion": 1,
    "scope": "owner_pet",
    "xpSource": "sum_persisted_reward_ledger_xpAwarded",
    "includeAllPolicyVersions": true,
    "deduplicateBy": [
      "ownerId",
      "sessionId"
    ],
    "selection": "highest_minimumTotalXp_not_exceeding_totalXp",
    "nextRank": "next_order_or_null_at_maximum",
    "progressMetric": "xp_within_current_tier",
    "progressFormula": "(totalXp-current.minimumTotalXp)/(next.minimumTotalXp-current.minimumTotalXp)",
    "progressRange": [
      0,
      1
    ],
    "maximumRankProgress": 1,
    "maximumRankRemainingXp": 0,
    "extraXpOnUpgrade": 0,
    "requiresConsecutiveDays": false,
    "inactivityXpDeduction": 0,
    "restOrSkippedPenalty": 0,
    "sessionDeletionChangesXp": false,
    "recomputeOn": [
      "reward_ledger_updated",
      "backup_restored",
      "policy_activated"
    ],
    "notAnAssessmentOf": [
      "intelligence",
      "obedience",
      "health",
      "mastery"
    ],
    "displayLabel": "Practice journey rank",
    "unknownVersionBehavior": "disable_rank_display_and_show_recoverable_error"
  }
}
