{
  "schemaVersion": 1,
  "policyVersion": 3,
  "rewards": [
    {
      "id": "practice_xp_v1",
      "label": "Practice log XP",
      "kind": "engagement",
      "xpPerEligibleSession": 10,
      "eligibleSessionResults": [
        "completed",
        "stopped"
      ],
      "requiresValidEvaluation": true,
      "requiresPetOwnership": true,
      "cap": {
        "scope": "owner_pet_all_exercises",
        "period": "local_calendar_day",
        "maxRewardedSessions": 1,
        "timeZoneSource": "persisted_session_iana_time_zone",
        "timeZoneChangesDoNotResetCap": true,
        "maxRewardedSessionsPerRolling24Hours": 1,
        "rewardDaySource": "trusted_accepted_at_in_persisted_zone"
      },
      "idempotencyKeyFields": [
        "ownerId",
        "sessionId",
        "policyId",
        "policyVersion"
      ],
      "performanceScoreAffectsXp": false,
      "stoppedSessionPenalty": 0,
      "awardAuthority": "trusted_application_transaction",
      "badgeIds": [
        "first_practice_log",
        "steady_week",
        "practice_partner",
        "growing_together",
        "routine_starter",
        "routine_companion"
      ],
      "ledgerRecordSchemaPath": "training/schemas/reward-ledger.schema.json",
      "sessionAwardUniquenessFields": [
        "ownerId",
        "sessionId"
      ],
      "sessionEditsCanAwardAgain": false,
      "policyUpgradeCanReaward": false,
      "rankProgressionPath": "rankProgression"
    }
  ],
  "badges": [
    {
      "id": "first_practice_log",
      "title": "First practice log",
      "rule": {
        "type": "eligible_session_count",
        "minimum": 1
      },
      "extraXp": 0,
      "scope": "owner_pet",
      "awardOnce": true
    },
    {
      "id": "steady_week",
      "title": "Steady week",
      "rule": {
        "type": "distinct_practice_days",
        "minimum": 3,
        "windowDays": 7
      },
      "extraXp": 0,
      "scope": "owner_pet",
      "awardOnce": true
    },
    {
      "id": "practice_partner",
      "title": "Practice Partner",
      "rule": {
        "type": "distinct_practice_days",
        "minimum": 10,
        "period": "all_time"
      },
      "extraXp": 0,
      "scope": "owner_pet",
      "awardOnce": true
    },
    {
      "id": "growing_together",
      "title": "Growing Together",
      "rule": {
        "type": "distinct_practice_days",
        "minimum": 30,
        "period": "all_time"
      },
      "extraXp": 0,
      "scope": "owner_pet",
      "awardOnce": true
    },
    {
      "id": "routine_starter",
      "title": "Routine Starter",
      "rule": {
        "type": "distinct_routine_practice_days",
        "minimum": 1,
        "period": "all_time"
      },
      "extraXp": 0,
      "scope": "owner_pet",
      "awardOnce": true
    },
    {
      "id": "routine_companion",
      "title": "Routine Companion",
      "rule": {
        "type": "distinct_routine_practice_days",
        "minimum": 7,
        "period": "all_time"
      },
      "extraXp": 0,
      "scope": "owner_pet",
      "awardOnce": true
    }
  ],
  "routines": [
    {
      "id": "pet_routine_v1",
      "enabledByDefault": false,
      "scheduleSource": "user_selected",
      "frequencyRecommendation": null,
      "allowRestDays": true,
      "allowSkippedDays": true,
      "missedDayPenalty": 0,
      "streakResetPenalty": 0,
      "progressMetric": "distinct_practice_days_per_week",
      "recordSchemaPath": "training/schemas/routine-record.schema.json",
      "eventRecordSchemaPath": "training/schemas/routine-event.schema.json"
    }
  ],
  "sharing": [
    {
      "id": "practice_card_v1",
      "enabled": true,
      "requiresExplicitUserAction": true,
      "requiresPreview": true,
      "autoPost": false,
      "defaultVisibility": "private",
      "formats": [
        "progress_card"
      ],
      "allowedFields": [
        "petDisplayName",
        "exerciseTitle",
        "sessionDate",
        "recordedAttemptCount",
        "independentAttemptCount",
        "observedSeconds",
        "milestoneLabel",
        "participationLabel",
        "badgeTitles",
        "userEditedCaption"
      ],
      "optionalMedia": {
        "enabled": true,
        "requiresExplicitSelection": true,
        "stripLocationMetadata": true
      },
      "excludedFields": [
        "ownerId",
        "petId",
        "sessionId",
        "location",
        "privateNotes",
        "comfort",
        "stopReason"
      ],
      "claims": {
        "allowAutomaticMasteryClaim": false,
        "allowExpertReviewedClaim": false
      },
      "publishMethod": "platform_share_sheet"
    }
  ],
  "badgeEvaluation": {
    "version": 1,
    "practiceDaySource": "reward_ledger_entries_with_positive_xp",
    "routineDaySource": "positive_xp_session_linked_to_valid_completed_routine_occurrence",
    "dateField": "localRewardDate",
    "scope": "owner_pet",
    "deduplicateBy": "local_calendar_date",
    "routineAggregation": "across_all_routines",
    "requiresConsecutiveDays": false,
    "restOrSkippedPenalty": 0,
    "recheckOn": [
      "session_accepted",
      "routine_session_linked"
    ],
    "retroactiveEvaluation": "evaluate_existing_valid_history_without_reissuing_xp",
    "awardUniquenessFields": [
      "ownerId",
      "petId",
      "badgeId"
    ],
    "awardTransaction": "atomically_attach_new_badge_ids_to_triggering_session_ledger_entry",
    "routineLinkMustMatch": [
      "ownerId",
      "petId",
      "sessionId",
      "templateId_in_routine"
    ],
    "unknownRuleBehavior": "disable_badge_award_and_show_recoverable_error"
  },
  "ranks": [
