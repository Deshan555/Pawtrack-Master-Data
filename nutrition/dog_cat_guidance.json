  "caloriePlanning": {
    "mode": "vet_target_first",
    "requiredInputs": [
      "dailyCalorieTargetKcal",
      "foodEnergyKcalPerUnit",
      "mealsPerDay"
    ],
    "formulas": [
      {
        "id": "meal_calories",
        "expression": "dailyCalorieTargetKcal / mealsPerDay",
        "purpose": "Split a veterinarian-confirmed daily target across scheduled meals."
      },
      {
        "id": "meal_portion",
        "expression": "mealCalories / foodEnergyKcalPerUnit",
        "purpose": "Convert meal calories using the food label's energy value."
      }
    ],
    "referenceOnlyEstimators": [
      {
        "speciesId": "dog",
        "id": "rer",
